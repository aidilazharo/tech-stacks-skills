{
  "schema": 1,
  "id": "atgv-role-expertise-handoff",
  "version": "0.1.0",
  "kind": "declarative-role-routing",
  "status": "catalog-contract",
  "description": "All 18 role-specific agents must use their own pinned skills; requests to produce another role's deliverable require a user-clickable switch. The extension core enforces identity, allowed roles and read-only handoff.",
  "authoritativeSources": [
    "ai-harness/manifest.json",
    "roles/<role-id>/SKILL.md",
    "ai-harness/context/project-snapshot.json"
  ],
  "activeRoleIsAuthority": true,
  "neverAutoSwitch": true,
  "switchRequiresUserClick": true,
  "checksEnabledRoles": true,
  "answerCrossRoleInformationalQuestionsInCurrentRole": true,
  "routeForeignRoleArtifactCreation": true,
  "preserveUserRequestAsDraft": true,
  "neverForwardPrivateChatHistoryWithoutConsent": true,
  "neverAutoEnableRoles": true,
  "neverAssumeApproval": true,
  "alwaysShowNextActionButton": true,
  "failureFallback": "Current role may provide informational advice and a verified navigation button; do not fabricate a specialist deliverable.",
  "roles": {
    "business-analyst": {
      "roleSkill": "roles/business-analyst/SKILL.md",
      "expertise": [
        "Stakeholder discovery",
        "BRD and functional requirements",
        "user stories and acceptance criteria",
        "requirements traceability"
      ]
    },
    "solution-architect": {
      "roleSkill": "roles/solution-architect/SKILL.md",
      "expertise": [
        "Architecture diagrams",
        "ADR",
        "API/integration design",
