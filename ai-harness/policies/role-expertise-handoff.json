        "accessibility and design handoff"
      ]
    },
    "software-developer": {
      "roleSkill": "roles/software-developer/SKILL.md",
      "expertise": [
        "Application source code",
        "frontend/backend implementation",
        "API implementation",
        "unit-test code",
        "bug fixes"
      ]
    },
    "project-manager": {
