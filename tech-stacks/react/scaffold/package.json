{
  "name": "atgv-react-api-sqlite",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"node server/index.mjs\"",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test test/ui.test.mjs",
    "test:api": "node --test server/api.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "db:migrate": "node server/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e:setup": "npm install --no-save --package-lock=false --ignore-scripts --no-audit --no-fund @playwright/test@1.65.1 @axe-core/playwright@4.14.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "express": "^4.21.0",
    "drizzle-orm": "^0.45.4",
    "@libsql/client": "^0.15.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "atgvOptionalBrowserTests": {
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
