{
  "name": "atgv-angular-api-sqlite",
  "private": true,
  "version": "0.1.3",
  "scripts": {
    "dev": "concurrently -k \"ng serve --host 127.0.0.1 --port 4200\" \"node server/index.mjs\"",
    "start": "node server/index.mjs",
    "build": "ng build",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "ng test --watch=false",
    "test:api": "node --test server/api.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "db:migrate": "node server/migrate.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.8.0",
    "zone.js": "~0.16.0",
    "express": "^4.21.0",
    "drizzle-orm": "^0.44.0",
    "@libsql/client": "^0.15.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "~6.0.0",
    "concurrently": "^9.2.0",
    "@angular/build": "^22.0.0",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^22.15.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
