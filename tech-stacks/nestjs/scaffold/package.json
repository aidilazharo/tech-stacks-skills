{
  "name": "atgv-nestjs-reference",
  "private": true,
  "version": "0.1.3",
  "scripts": {
    "dev": "ts-node -P tsconfig.json src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run test/task-validation.test.ts",
    "test:api": "vitest run test/api.integration.test.ts",
    "test:static": "node --test test/static.test.mjs",
    "db:migrate": "ts-node -P tsconfig.json src/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@nestjs/swagger": "^11.0.0",
    "@libsql/client": "^0.15.0",
    "drizzle-orm": "^0.45.4",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^5.1.1",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "@nestjs/testing": "^11.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
