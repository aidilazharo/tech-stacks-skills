{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "framework": "Bootstrap",
  "version": "5.3.6",
  "colorModes": [
    "light",
    "dark"
  ],
  "breakpoints": {
    "sm": "576px",
    "md": "768px",
    "lg": "992px",
    "xl": "1200px",
    "xxl": "1400px"
  },
  "gridColumns": 12,
  "containerMaxWidth": {
    "sm": "540px",
    "md": "720px",
    "lg": "960px",
    "xl": "1140px",
    "xxl": "1320px"
  },
  "spacing": {
    "spacer": "1rem",
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "1rem",
    "4": "1.5rem",
    "5": "3rem"
  },
  "radius": {
    "default": "0.375rem",
    "lg": "0.5rem",
    "pill": "50rem"
  },
  "cssVariables": [
    "--bs-body-color",
    "--bs-body-bg",
    "--bs-primary",
    "--bs-secondary",
    "--bs-success",
    "--bs-danger",
    "--bs-warning",
    "--bs-info",
    "--bs-border-color",
    "--bs-border-radius",
    "--bs-gutter-x",
    "--bs-gutter-y"
  ]
}
