{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Qi-inspired AI UI Kit",
  "version": "1.0.0",
  "status": "unofficial-original-implementation",
  "disclaimer": "This is an independent design starter, not an export of AIA Qi tokens. Replace starter values with your organization's authorized design-token exports before claiming brand compliance.",
  "provenance": {
    "publiclyDocumented": [
      "primary semantic colors red / charcoal / white",
      "red accents limited to approximately 20 percent of a layout",
      "4px soft spacing grid",
      "up to 12 layout columns",
      "reference viewports 375x812, 768x1024, 1024x768, 1440x900",
      "AIA Everest and Open Sans for English, Noto Sans for localization",
      "foundation, atom, molecule, organism, template, flow structure"
    ],
    "starterEstimates": [
      "all exact hex values and tint scales",
      "component sizes, borders, radii, shadows, font sizes and breakpoints",
      "specific usage and behavioral design patterns"
    ],
    "sources": [
      "https://design.aia.com/aia-qi-design-system",
      "https://design.aia.com/colour",
      "https://design.aia.com/spacing",
      "https://design.aia.com/grid-and-layout",
      "https://design.aia.com/typography",
      "https://design.aia.com/shadow",
      "https://design.aia.com/components",
      "https://design.aia.com/design-standards",
      "https://design.aia.com/blog/how-the-qi-design-system-became-aias-single-source-of-truth-across-18-markets"
    ]
  },
  "color": {
    "primary": { "50": "#fff2f5", "100": "#ffe1e9", "200": "#ffb8ca", "300": "#f883a0", "400": "#ea4775", "500": "#d31145", "600": "#b30e3c", "700": "#8e0b30", "800": "#650822" },
    "charcoal": { "50": "#f7f8f9", "100": "#eff1f3", "200": "#dfe3e7", "300": "#c1c8cf", "400": "#97a0a9", "500": "#66727e", "600": "#333d47", "700": "#28313a", "800": "#192128" },
    "secondary": { "salmon": "#d66e66", "purple": "#6953a8", "warmGrey": "#a18469" },
    "semantic": { "success": "#167349", "warning": "#8b5700", "danger": "#b42338", "info": "#215b9a", "background": "#f7f8fa", "surface": "#ffffff", "border": "#dce1e5", "bodyText": "#192128", "mutedText": "#52616d" }
  },
  "typography": {
    "bodyFontFamily": ["Open Sans", "Noto Sans", "system-ui", "sans-serif"],
    "displayFontFamily": ["AIA Everest", "Open Sans", "Noto Sans", "system-ui", "sans-serif"],
    "notes": "AIA Everest is proprietary. The kit does not include font files and falls back to public/system fonts.",
    "sizesRem": { "xs": 0.75, "sm": 0.875, "md": 1, "lg": 1.125, "xl": 1.375, "2xl": 1.75, "3xl": 2.375 },
    "defaultLineHeight": 1.55
  },
  "spacePx": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radiiPx": { "sm": 6, "md": 10, "lg": 16, "xl": 22 },
  "viewportReferences": {
    "mobile": { "width": 375, "height": 812 },
    "tabletPortrait": { "width": 768, "height": 1024 },
    "tabletLandscape": { "width": 1024, "height": 768 },
    "desktop": { "width": 1440, "height": 900 }
  },
  "responsiveClassBreakpointsMinPx": { "sm": 576, "md": 768, "lg": 1024, "xl": 1440 },
  "grid": { "columns": 12, "gapPx": 24, "maxContainerPx": 1240 },
  "motion": { "standardMs": 160, "reducedMotionSupported": true },
  "principles": ["purposeful", "human", "delightful", "unified", "clarity", "efficient"],
  "designHierarchy": ["foundation", "atom", "molecule", "organism", "template", "flow"]
}
