{
  "name":"Qi-inspired independent component catalog",
  "version":"1.0.0",
  "rules":{"prefix":"qi-","nativeSemanticsPreferred":true,"minimumClickTargetPx":44,"officialQiLibrary":false},
  "components":[
    {"name":"Container","category":"layout","classes":["qi-container","qi-container-fluid"],"use":"Content width and page margins"},
    {"name":"Grid","category":"layout","classes":["qi-row","qi-col-12","qi-col-md-6","qi-col-lg-4"],"use":"12-column responsive grid"},
    {"name":"Flex","category":"layout","classes":["qi-flex","qi-stack","qi-wrap","qi-gap-4","qi-align-center"],"use":"Alignment and grouping"},
    {"name":"App shell","category":"layout","classes":["qi-shell","qi-shell-top","qi-shell-sidebar","qi-shell-main"],"use":"Sidebar dashboard shell"},
    {"name":"Button","category":"action","classes":["qi-btn","qi-btn-primary","qi-btn-secondary","qi-btn-ghost","qi-btn-danger","qi-btn-sm","qi-btn-lg"],"states":["default","hover","focus","disabled"]},
    {"name":"Button group","category":"action","classes":["qi-btn-group"],"use":"Related actions grouped clearly"},
    {"name":"Card","category":"display","classes":["qi-card","qi-card-elevated","qi-card-compact","qi-card-header","qi-card-footer"]},
    {"name":"KPI","category":"display","classes":["qi-kpi","qi-kpi-label","qi-trend"],"use":"Summary metrics with visible text"},
    {"name":"Badge","category":"display","classes":["qi-badge","qi-badge-success","qi-badge-warning","qi-badge-danger","qi-badge-info"],"use":"Non-interactive state labeling"},
    {"name":"Tag","category":"display","classes":["qi-tag"],"use":"Non-interactive categorical label"},
    {"name":"Table","category":"display","classes":["qi-table-wrap","qi-table"],"use":"Scannable data tables; horizontal scroll on narrow screens"},
    {"name":"Avatar","category":"display","classes":["qi-avatar","qi-avatar-lg"],"use":"Initials; no proprietary profile imagery"},
    {"name":"Separator","category":"display","classes":["qi-divider"]},
    {"name":"Text field","category":"input","classes":["qi-field","qi-label","qi-input","qi-help"],"semantic":"label[for] + input[id]"},
    {"name":"Select / dropdown","category":"input","classes":["qi-select"],"semantic":"native select with associated label"},
    {"name":"Date input","category":"input","classes":["qi-input"],"semantic":"input[type=date]"},
    {"name":"Textarea","category":"input","classes":["qi-textarea"]},
    {"name":"Checkbox","category":"input","classes":["qi-check"],"semantic":"input[type=checkbox]"},
    {"name":"Radio","category":"input","classes":["qi-radio"],"semantic":"input[type=radio]"},
    {"name":"Switch","category":"input","classes":["qi-switch","qi-switch-track"],"semantic":"input[type=checkbox] + track"},
    {"name":"Chip","category":"input","classes":["qi-chip"],"semantic":"button[aria-pressed]","behavior":"click to toggle pressed state"},
    {"name":"File picker","category":"input","classes":["qi-field","qi-label"],"semantic":"native input[type=file]","use":"Add application-specific server validation"},
    {"name":"Breadcrumb","category":"navigation","classes":["qi-breadcrumb"],"semantic":"nav[aria-label] > ol"},
    {"name":"Side navigation","category":"navigation","classes":["qi-nav","qi-nav-link"],"semantic":"nav with aria-current page"},
    {"name":"Tabs","category":"navigation","classes":["qi-tabs","qi-tab","qi-tab-panel"],"behavior":"click + arrow/Home/End keys","semantic":"tablist/tab/tabpanel with aria-controls"},
    {"name":"Accordion","category":"navigation","classes":["qi-accordion","qi-accordion-item","qi-accordion-trigger","qi-accordion-panel"],"behavior":"click to expand/collapse","semantic":"button[aria-expanded][aria-controls]"},
    {"name":"Alert","category":"feedback","classes":["qi-alert","qi-alert-success","qi-alert-warning","qi-alert-danger"],"use":"Persistent contextual status"},
    {"name":"Progress","category":"feedback","classes":["qi-progress","qi-progress-bar","qi-progress-success","qi-progress-warning"],"semantic":"role=progressbar plus aria-valuenow etc"},
    {"name":"Stepper","category":"feedback","classes":["qi-steps","qi-step","qi-step-dot"],"use":"Multi-stage progress; text names"},
    {"name":"Skeleton","category":"feedback","classes":["qi-skeleton"],"use":"Visual loading affordance; supply accessible status"},
    {"name":"Empty state","category":"feedback","classes":["qi-empty","qi-empty-icon"],"use":"Explain missing content and suggest next action"},
    {"name":"Modal","category":"overlay","classes":["qi-modal-backdrop","qi-modal","qi-modal-head","qi-modal-close","qi-modal-actions"],"behavior":"data-qi-modal-open and data-qi-dismiss modal","api":"QiUI.openModal(id)"},
    {"name":"Toast","category":"overlay","classes":["qi-toast-region","qi-toast"],"behavior":"data-qi-toast or QiUI.toast(message,type)"},
    {"name":"Theme","category":"foundation","behavior":"data-qi-theme-toggle or QiUI.setTheme('dark'|'light')","use":"Opt-in alternate surface tokens; test contrast"}
  ]
}
